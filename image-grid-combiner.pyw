@dataclass
class ImageItem:
    path: str
    name: str
    label: str
    width: int = 0
    height: int = 0
    thumb: object = None
    enabled: bool = True
    error: str = ""

    def load_thumb(self, thumb_size=(48, 48)) -> bool:
        if not HAS_PIL:
            self.error = "Pillow не установлен"
            return False
        try:
            with Image.open(self.path) as im:
                self.width, self.height = im.size
                if not self.width or not self.height:
                    raise ValueError("нулевой размер")
                try:
                    im.draft("RGB", thumb_size)
                except Exception:
                    pass
                t = im.convert("RGBA")
                t.thumbnail(thumb_size, Image.BILINEAR)
                self.thumb = t
            self.error = ""
            return True
        except Exception as e:
            self.error = str(e)
            return False

    def open_full(self):
        im = Image.open(self.path)
        if im.mode != "RGBA":
            im = im.convert("RGBA")
        return im


