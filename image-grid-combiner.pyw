    # --- Операции со списком ---

    def _selected_indices(self) -> List[int]:
        paths = list(self.tree.get_children())
        idx = {p: i for i, p in enumerate(paths)}
        sel = sorted(idx[p] for p in self.tree.selection() if p in idx)
        return sel

    def move_selected(self, delta: int):
        paths = list(self.tree.get_children())
        if not paths:
            return
        sel = self._selected_indices()
        if not sel:
            return

        n = len(paths)
        sel_set = set(sel)
        sel_paths = [paths[i] for i in sel]
        others = [paths[i] for i in range(n) if i not in sel_set]

        # Целевая позиция первого выделенного
        if delta < 0:
            target = max(0, sel[0] + delta)
        else:
            target = min(len(others), sel[-1] + delta - (len(sel) - 1))

        new_paths = others[:target] + sel_paths + others[target:]
        self._apply_order(new_paths)
        self.tree.selection_set(sel_paths)

    def _apply_order(self, paths):
        order = {p: i for i, p in enumerate(paths)}
        self.items.sort(key=lambda it: order.get(it.path, 1 << 30))
        for i, p in enumerate(paths):
            self.tree.move(p, "", i)
        self.schedule_preview()

    def set_all(self, value: bool):
        for it in self.items:
            it.enabled = value
            self._update_tree_row(it)
        self._update_files_count()
        self.schedule_preview()

    def invert_all(self):
        for it in self.items:
            it.enabled = not it.enabled
            self._update_tree_row(it)
        self._update_files_count()
        self.schedule_preview()

    def _toggle_selected(self):
        sel = self.tree.selection()
        if not sel:
            return
        states = [self.item_by_path[p].enabled for p in sel if p in self.item_by_path]
        new_state = not all(states)
        for p in sel:
            it = self.item_by_path.get(p)
            if it:
                it.enabled = new_state
                self._update_tree_row(it)
        self._update_files_count()
        self.schedule_preview()

    def _update_tree_row(self, item: ImageItem):
        mark = "V" if item.enabled else " "
        size = "{}x{}".format(item.width, item.height) if item.width else ""
        status = item.error if item.error else ("ok" if item.width else "")
        vals = (mark, item.name, size, status, "[ ]")
        if self.tree.exists(item.path):
            self.tree.item(item.path, values=vals)

    def _update_files_count(self):
        on = sum(1 for it in self.items if it.enabled)
        self.files_count_var.set("{} / {}".format(on, len(self.items)))

    # --- Дерево: клики / drag ---

    def _tree_click(self, event):
        region = self.tree.identify_region(event.x, event.y)
        if region != "cell":
            self._drag_start_iid = None
            return
        col = self.tree.identify_column(event.x)
        row = self.tree.identify_row(event.y)
        if not row:
            self._drag_start_iid = None
            return
        if self._rename_entry is not None and row != self._rename_path:
            self._commit_rename()
        if col == "#1":
            item = self.item_by_path.get(row)
            if item:
                item.enabled = not item.enabled
                self._update_tree_row(item)
                self._update_files_count()
                self.schedule_preview()
            self._drag_start_iid = None
            return
        self._drag_start_iid = row

    def _tree_b1_motion(self, event):
        if not self._drag_start_iid:
            return
        target = self.tree.identify_row(event.y)
        if not target or target == self._drag_start_iid:
            return
        paths = list(self.tree.get_children())
        try:
            src_i = paths.index(self._drag_start_iid)
            dst_i = paths.index(target)
        except ValueError:
            return
        paths.pop(src_i)
        paths.insert(dst_i, self._drag_start_iid)
        self._apply_order(paths)
        self.tree.selection_set(self._drag_start_iid)

    def _tree_double_click(self, event):
        region = self.tree.identify_region(event.x, event.y)
        col = self.tree.identify_column(event.x)
        row = self.tree.identify_row(event.y)
        if not row:
            return
        if region == "cell" and col == "#2":
            self._start_rename(row)
            return "break"
        self._open_path(row)

    def _open_path(self, path: str):
        try:
            if os.name == "nt":
                os.startfile(path)
            elif sys.platform == "darwin":
                os.system('open "{}"'.format(path))
            else:
                os.system('xdg-open "{}"'.format(path))
        except Exception as e:
            messagebox.showerror("Ошибка", str(e))

    # --- Inline-переименование ---

    def _start_rename_selected(self):
        sel = self.tree.selection()
        if sel:
            self._start_rename(sel[0])

    def _start_rename(self, path):
        if path not in self.item_by_path:
            return
        if self._rename_entry is not None:
            self._commit_rename()

        item = self.item_by_path[path]
        self._hide_hover()

        self._rename_saved_selection = list(self.tree.selection())
        self.tree.selection_remove(*self._rename_saved_selection)

        bbox = self.tree.bbox(path, column="#2")
        if not bbox:
            self.tree.see(path)
            self.tree.update_idletasks()
            bbox = self.tree.bbox(path, column="#2")
            if not bbox:
                self.tree.selection_set(self._rename_saved_selection)
                self._rename_saved_selection = []
                return
        x, y, w, h = bbox

        row_bg = self._tree_row_bg()
        row_fg = self._tree_row_fg()
        var = tk.StringVar(value=item.name)
        entry = tk.Entry(
            self.tree, textvariable=var, borderwidth=0, relief="flat",
            highlightthickness=1, highlightbackground="#3b7fd9",
            highlightcolor="#3b7fd9", bg=row_bg, fg=row_fg,
            insertbackground=row_fg, selectbackground="#3b7fd9",
            selectforeground="#ffffff",
        )
        entry.place(x=x, y=y, width=w, height=h)
        entry.focus_set()
        root, _ext = os.path.splitext(item.name)
        sel_end = len(root)
        entry.after(1, lambda e=entry, n=sel_end: (e.select_range(0, n), e.icursor(n)))

        self._rename_entry = entry
        self._rename_var = var
        self._rename_path = path
        entry.bind("<Return>", lambda e: self._commit_rename())
        entry.bind("<Escape>", lambda e: self._cancel_rename())
        entry.bind("<FocusOut>", lambda e: self._commit_rename())

    def _tree_row_bg(self) -> str:
        try:
            return ttk.Style(self).lookup("Treeview", "background") or "#ffffff"
        except Exception:
            return "#ffffff"

    def _tree_row_fg(self) -> str:
        try:
            return ttk.Style(self).lookup("Treeview", "foreground") or "#000000"
        except Exception:
            return "#000000"

    def _restore_selection(self, saved: List[str]):
        valid = [p for p in saved if self.tree.exists(p)]
        if valid:
            self.tree.selection_set(valid)

    def _commit_rename(self):
        if self._rename_entry is None:
            return
        entry = self._rename_entry
        var = self._rename_var
        path = self._rename_path
        saved_sel = self._rename_saved_selection

        self._rename_entry = None
        self._rename_var = None
        self._rename_path = None
        self._rename_saved_selection = []

        try:
            entry.destroy()
        except Exception:
            pass

        item = self.item_by_path.get(path)
        if item is None:
            self._restore_selection(saved_sel)
            return

        new_name = (var.get() or "").strip()
        if not new_name or new_name == item.name:
            self._restore_selection(saved_sel)
            return

        bad = set('<>:"/\\|?*')
        if any(c in bad for c in new_name) or new_name in (".", ".."):
            messagebox.showerror("Переименование", "Недопустимое имя файла.")
            self._restore_selection(saved_sel)
            return

        old_ext = os.path.splitext(item.name)[1]
        new_root, new_ext = os.path.splitext(new_name)
        if not new_ext:
            new_name = new_root + old_ext

        folder = os.path.dirname(item.path)
        new_path = os.path.join(folder, new_name)

        if os.path.abspath(new_path) == os.path.abspath(item.path):
            self._restore_selection(saved_sel)
            return
        if os.path.exists(new_path):
            messagebox.showerror("Переименование",
                                 "Файл с таким именем уже существует:\n{}".format(new_name))
            self._restore_selection(saved_sel)
            return
        try:
            os.rename(item.path, new_path)
        except Exception as e:
            messagebox.showerror("Переименование",
                                 "Не удалось переименовать:\n{}".format(e))
            self._restore_selection(saved_sel)
            return

        old_path = item.path
        item.path = new_path
        item.name = new_name
        item.label = os.path.splitext(new_name)[0]

        self.item_by_path.pop(old_path, None)
        self.item_by_path[new_path] = item

        if self.tree.exists(old_path):
            idx = self.tree.index(old_path)
            self.tree.delete(old_path)
            self.tree.insert("", idx, iid=new_path,
                             values=(" ", item.name, "", "", "🔍"))
            self._update_tree_row(item)
            self.tree.selection_set(new_path)
            self.tree.focus(new_path)
            self.tree.see(new_path)

        self.log("Переименовано: {} -> {}".format(os.path.basename(old_path), new_name))
        self.schedule_preview(force=True)

    def _cancel_rename(self):
        if self._rename_entry is None:
            return
        saved_sel = self._rename_saved_selection
        try:
            self._rename_entry.destroy()
        except Exception:
            pass
        self._rename_entry = None
        self._rename_var = None
        self._rename_path = None
        self._rename_saved_selection = []
        self._restore_selection(saved_sel)

    # --- Удаление ---

    def delete_selected_files(self):
        sel = list(self.tree.selection())
        if not sel:
            messagebox.showinfo("Удаление", "Ничего не выделено.")
            return
        if self._rename_entry is not None:
            self._commit_rename()

        names = [os.path.basename(p) for p in sel]
        preview = "\n".join(names[:15])
        if len(names) > 15:
            preview += "\n… и ещё {}".format(len(names) - 15)

        if not messagebox.askyesno(
            "Удалить с диска",
            "Удалить безвозвратно {} файл(ов) минуя корзину?\n\n{}\n\n"
            "Отменить это действие будет невозможно.".format(len(names), preview)
        ):
            return

        errors = []
        deleted = 0
        for path in sel:
            item = self.item_by_path.get(path)
            try:
                if os.path.isfile(path):
                    os.remove(path)
                self.item_by_path.pop(path, None)
                if item in self.items:
                    self.items.remove(item)
                if self.tree.exists(path):
                    self.tree.delete(path)
                deleted += 1
            except Exception as e:
                errors.append("{}: {}".format(os.path.basename(path), e))

        self._update_files_count()
        self.schedule_preview(force=True)

        if errors:
            messagebox.showerror(
                "Удаление",
                "Удалено: {}.\nОшибки:\n{}".format(deleted, "\n".join(errors))
            )
        else:
            self.log("Удалено с диска: {} файл(ов).".format(deleted))

    # --- Hover-превью ---

    def _tree_motion(self, event):
        region = self.tree.identify_region(event.x, event.y)
        if region != "cell" or self.tree.identify_column(event.x) != "#5":
            self._hide_hover()
            return
        row = self.tree.identify_row(event.y)
        if not row:
            self._hide_hover()
            return
        if row == self._hover_current_path and self._hover_win is not None:
            return
        self._hover_current_path = row
        self._hide_hover(keep_path=True)
        self._hover_job = self.after(
            200, lambda: self._show_hover(row, event.x_root, event.y_root))

    def _show_hover(self, path, x_root, y_root, max_w=240, max_h=240):
        self._hover_job = None
        item = self.item_by_path.get(path)
        if item is None:
            return
        if item.thumb is None:
            item.load_thumb()
        if item.thumb is None:
            return
        try:
            im = item.thumb.copy()
            im.thumbnail((max_w, max_h), Image.BILINEAR)
        except Exception:
            return
        w, h = im.size
        self._hover_photo = ImageTk.PhotoImage(im)
        win = tk.Toplevel(self)
        win.wm_overrideredirect(True)
        win.attributes("-topmost", True)
        sw, sh = self.winfo_screenwidth(), self.winfo_screenheight()
        x = x_root + 16
        y = y_root + 12
        if x + w + 8 > sw:
            x = max(0, x_root - w - 16)
        if y + h + 8 > sh:
            y = max(0, sh - h - 16)
        win.geometry("{}x{}+{}+{}".format(w, h, x, y))
        frame = tk.Frame(win, bd=1, relief="solid", bg="#222")
        frame.pack(fill="both", expand=True)
        lbl = tk.Label(frame, image=self._hover_photo, bd=0, bg="#222")
        lbl.pack()
        self._hover_win = win
        self._hover_label = lbl

    def _hide_hover(self, keep_path=False):
        if self._hover_job is not None:
            try:
                self.after_cancel(self._hover_job)
            except Exception:
                pass
            self._hover_job = None
        if self._hover_win is not None:
            try:
                self._hover_win.destroy()
            except Exception:
                pass
            self._hover_win = None
            self._hover_label = None
        self._hover_photo = None
        if not keep_path:
            self._hover_current_path = None

