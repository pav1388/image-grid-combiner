class App(tk.Tk):
    def __init__(self):
        super().__init__()
        if not HAS_PIL:
            messagebox.showerror(
                "Нет Pillow",
                "Не найден модуль Pillow.\nУстановите: pip install pillow"
            )
            raise SystemExit(1)
        style = ttk.Style(self)
        style.configure("Accent.TLabelframe.Label",
                        font=("TkDefaultFont", 9, "bold"))
        self.title("Image Grid Combiner " + MAIN_VERSION + " by pav13")
        self.minsize(300, 200)

        self._loaded = self._load_settings()
        self.geometry(self._loaded.get("window_geometry", DEFAULTS["window_geometry"]))
        self._restore_maximized = bool(self._loaded.get("window_maximized", False))
        self.protocol("WM_DELETE_WINDOW", self._on_close)

        self._init_vars(self._loaded)
        self._init_state()

        self._build_ui()
        self._configure_renderer()
        self._apply_theme(self.theme_var.get(), initial=True)
        
        self.after(100, self.refresh_files)
        self._normal_geometry = self.geometry()
        self.bind("<Configure>", self._on_configure)
        if self._restore_maximized:
            self.after(50, self._apply_maximized)

    # --- Инициализация переменных ---

    def _init_vars(self, s):
        get = lambda k: s.get(k, DEFAULTS[k])
        self.theme_var = tk.StringVar(value=get("theme"))
        self.input_folder_var = tk.StringVar(value=get("input_folder"))
        self.output_file_var = tk.StringVar(value=get("output_file"))
        self.output_dir_var = tk.StringVar(value=get("output_dir"))
        self.font_size_var = tk.IntVar(value=get("font_size"))
        self.font_size_scale_var = tk.IntVar(value=get("font_size_scale"))

        saved_font = get("font_path")
        self.font_path_var = tk.StringVar(
            value=saved_font if saved_font and os.path.isfile(saved_font) else "")

        self.font_bold_var = tk.BooleanVar(value=get("font_bold"))
        self.font_italic_var = tk.BooleanVar(value=get("font_italic"))
        self.font_underline_var = tk.BooleanVar(value=get("font_underline"))
        self.gap_var = tk.IntVar(value=get("gap"))
        self.padding_var = tk.IntVar(value=get("padding"))
        self.line_space_var = tk.IntVar(value=get("line_spacing"))
        self.size_mode_var = tk.StringVar(value=get("size_mode"))
        self.show_labels_var = tk.BooleanVar(value=get("show_labels"))
        self.bg_var = tk.StringVar(value=get("bg_color"))
        self.text_var = tk.StringVar(value=get("text_color"))
        self.ratio_var = tk.DoubleVar(value=get("target_ratio"))
        self.cols_var = tk.IntVar(value=get("force_cols"))
        self.sort_var = tk.StringVar(value=get("sort_key"))
        self.random_bg_color_var = tk.BooleanVar(value=get("random_bg_color"))
        self.img_align_x_var = tk.StringVar(value=get("img_align_x"))
        self.img_align_y_var = tk.StringVar(value=get("img_align_y"))
        self.label_pos_var = tk.StringVar(value=get("label_position"))
        self.label_align_var = tk.StringVar(value=get("label_align"))
        self.auto_preview_var = tk.BooleanVar(value=get("auto_preview_update"))
        self.preview_max_size_var = tk.IntVar(value=get("preview_max_size"))
        self.thumbnail_max_size_var = tk.IntVar(value=get("thumbnail_max_size"))
        self.output_max_megapixels_var = tk.IntVar(value=get("output_max_megapixels"))

    def _init_state(self):
        self.items: List[ImageItem] = []
        self.item_by_path: Dict[str, ImageItem] = {}
        self.renderer = TextRenderer()
        self._embedded_font_bytes = embedded_font_bytes()
        self._random_bg_color = random_pastel_color()

        self.preview_image = None
        self._preview_pil = None
        self._preview_job = None
        self._preview_busy = False
        self._building = False
        self._files_ready = False
        self._thumbs_active = False

        self._hover_win = None
        self._hover_label = None
        self._hover_job = None
        self._hover_photo = None
        self._hover_current_path = None

        self._drag_start_iid = None
        self._last_click_path = None
        self._last_click_time = 0.0
        self._rename_entry = None
        self._rename_var = None
        self._rename_path = None
        self._rename_saved_selection: List[str] = []

    # --- Настройки ---

    def _settings_path(self):
        return os.path.join(os.path.dirname(os.path.abspath(__file__)), SETTINGS_FILE_NAME)

    def _load_settings(self) -> dict:
        try:
            with open(self._settings_path(), "r", encoding="utf-8") as f:
                data = json.load(f)
            if isinstance(data, dict):
                return data
        except Exception:
            pass
        return {}

    def _is_maximized(self) -> bool:
        try:
            st = self.state()
            if st == "zoomed":
                return True
            if st == "normal":
                try:
                    return bool(self.attributes("-zoomed"))
                except Exception:
                    return False
        except Exception:
            pass
        return False

    def _collect_settings(self) -> dict:
        if self._is_maximized():
            geo = getattr(self, "_normal_geometry", None) or self.geometry()
            maximized = True
        else:
            geo = self.geometry()
            maximized = False
        return {
            "_comment": "Image Grid Combiner {} settings".format(MAIN_VERSION),
            "input_folder": self.input_folder_var.get(),
            "output_file": self.output_file_var.get(),
            "output_dir": self.output_dir_var.get(),
            "font_size": int(self.font_size_var.get()),
            "font_size_scale": int(self.font_size_scale_var.get()),
            "font_path": self.font_path_var.get(),
            "font_bold": bool(self.font_bold_var.get()),
            "font_italic": bool(self.font_italic_var.get()),
            "font_underline": bool(self.font_underline_var.get()),
            "gap": int(self.gap_var.get()),
            "padding": int(self.padding_var.get()),
            "line_spacing": int(self.line_space_var.get()),
            "show_labels": bool(self.show_labels_var.get()),
            "size_mode": self.size_mode_var.get(),
            "bg_color": self.bg_var.get(),
            "text_color": self.text_var.get(),
            "target_ratio": float(self.ratio_var.get()),
            "force_cols": int(self.cols_var.get()),
            "img_align_x": self.img_align_x_var.get(),
            "img_align_y": self.img_align_y_var.get(),
            "label_position": self.label_pos_var.get(),
            "label_align": self.label_align_var.get(),
            "sort_key": self.sort_var.get(),
            "random_bg_color": bool(self.random_bg_color_var.get()),
            "window_geometry": geo,
            "window_maximized": maximized,
            "auto_preview_update": bool(self.auto_preview_var.get()),
            "preview_max_size": int(self.preview_max_size_var.get()),
            "thumbnail_max_size": int(self.thumbnail_max_size_var.get()),
            "output_max_megapixels": int(self.output_max_megapixels_var.get()),
            "theme": self.theme_var.get(),
        }

    def _save_settings(self):
        try:
            with open(self._settings_path(), "w", encoding="utf-8") as f:
                json.dump(self._collect_settings(), f, ensure_ascii=False, indent=2)
        except Exception as e:
            print("Не удалось сохранить настройки:", e)

    def _apply_maximized(self):
        try:
            if os.name == "nt" or sys.platform == "darwin":
                self.state("zoomed")
            else:
                self.attributes("-zoomed", True)
        except Exception:
            try:
                self.state("zoomed")
            except Exception:
                sw, sh = self.winfo_screenwidth(), self.winfo_screenheight()
                self.geometry("{}x{}+0+0".format(sw, sh))

    def _on_configure(self, event=None):
        if event is not None and event.widget is not self:
            return
        if not self._is_maximized():
            try:
                self._normal_geometry = self.geometry()
            except Exception:
                pass

    def _on_close(self):
        self._hide_hover()
        self._save_settings()
        self.destroy()

    def reset_settings(self):
        if not messagebox.askyesno(
                "Сброс настроек",
                "Сбросить все настройки к значениям по умолчанию?"
        ):
