    # --- UI хелперы ---
    
    def _apply_theme(self, name: str, initial=False):
        if name not in THEMES:
            name = "light"
        self.theme_var.set(name)
        palette = THEMES[name]

        apply_ttk_theme(self, name, palette)
        self.configure(bg=palette["bg"])

        skip_widgets = set()
        for w in (getattr(self, "bg_swatch", None),
                  getattr(self, "text_swatch", None)):
            if w is not None:
                skip_widgets.add(w)

        apply_tk_theme_recursive(self, palette, skip=skip_widgets)

        for sw, var in ((getattr(self, "bg_swatch", None), self.bg_var),
                        (getattr(self, "text_swatch", None), self.text_var)):
            if sw is not None:
                try:
                    sw.configure(bg=var.get(), highlightbackground=palette["border"])
                except tk.TclError:
                    pass

        try:
            self.font_hint_label.configure(foreground=palette["hint_fg"]) \
                if hasattr(self, "font_hint_label") else None
        except Exception:
            pass

        if hasattr(self, "log_text"):
            self.log_text.configure(bg=palette["log_bg"], fg=palette["log_fg"])
            
        if hasattr(self, "preview_busy_label"):
            try:
                self.preview_busy_label.configure(foreground=palette["accent_fg"])
            except tk.TclError:
                pass

        if not initial:
            self.log("Тема: {}".format("тёмная" if name == "dark" else "светлая"))


    def _toggle_theme(self):
        self._apply_theme("dark" if self.theme_var.get() == "light" else "light")

    def _btn(self, parent, **kwargs):
        tip = kwargs.pop("tooltip", None)
        btn = ttk.Button(parent, **kwargs)
        if tip:
            add_tooltip(btn, tip)
        return btn

    def _make_scrollable(self, outer) -> ttk.Frame:
        """Оборачивает содержимое в прокручиваемый Canvas и возвращает inner-фрейм."""
        canvas = tk.Canvas(outer, highlightthickness=0)
        vbar = ttk.Scrollbar(outer, orient="vertical", command=canvas.yview)
        canvas.configure(yscrollcommand=vbar.set)
        vbar.pack(side="right", fill="y")
        canvas.pack(side="left", fill="both", expand=True)

        inner = ttk.Frame(canvas)
        inner_id = canvas.create_window((0, 0), window=inner, anchor="nw")

        inner.bind("<Configure>",
                   lambda e: canvas.configure(scrollregion=canvas.bbox("all")))
        canvas.bind("<Configure>",
                    lambda e: canvas.itemconfigure(inner_id, width=e.width))

        def _on_wheel(event):
            delta = -1 if event.num == 4 else (1 if event.num == 5 else int(-event.delta / 120))
            canvas.yview_scroll(delta, "units")

        def _bind(_e):
            canvas.bind_all("<MouseWheel>", _on_wheel)
            canvas.bind_all("<Button-4>", _on_wheel)
            canvas.bind_all("<Button-5>", _on_wheel)

        def _unbind(_e):
            canvas.unbind_all("<MouseWheel>")
            canvas.unbind_all("<Button-4>")
            canvas.unbind_all("<Button-5>")

        canvas.bind("<Enter>", _bind)
        canvas.bind("<Leave>", _unbind)
        return inner

