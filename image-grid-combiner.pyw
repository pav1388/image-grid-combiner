# Рендер
# ---------------------------------------------------------------------------

def _paste_image(canvas, layout_item, img_x, img_y, preview, preview_thumbs, scale, log):
    it = layout_item.item
    iw, ih = layout_item.iw, layout_item.ih

    if preview:
        thumb = preview_thumbs.get(it.path)
        if thumb is None:
            log("Пропуск (нет миниатюры) {}".format(it.name))
            return
        try:
            t = thumb if thumb.size == (iw, ih) else thumb.resize((iw, ih), Image.BILINEAR)
            canvas.alpha_composite(t, (img_x, img_y))
        except Exception as e:
            log("Пропуск (превью) {}: {}: {}".format(it.name, type(e).__name__, e))
        return

    full = None
    try:
        full = it.open_full()
        if full.size != (iw, ih):
            full = full.resize((iw, ih), Image.LANCZOS)
    except MemoryError:
        log("Пропуск (память) {}".format(it.name))
    except Exception as e:
        log("Пропуск (открытие) {}: {}: {}".format(it.name, type(e).__name__, e))
    if full is not None:
        try:
            canvas.alpha_composite(full, (img_x, img_y))
        except Exception as e:
            log("Пропуск (вставка) {}: {}: {}".format(it.name, type(e).__name__, e))
        finally:
            try:
                full.close()
            except Exception:
                pass


def _compute_positions(li: LayoutItem, cell_x, cell_y, cell_w, cell_h,
                       img_align_x, img_align_y, label_pos, show_labels):
    """Возвращает (img_x, img_y, text_box_x, text_box_y, text_box_w)."""
    free_w = cell_w - li.block_w
    free_h = cell_h - li.block_h

    if img_align_x == "left":
        bx = 0
    elif img_align_x == "right":
        bx = free_w
    else:
        bx = free_w // 2

    if img_align_y == "top":
        by = 0
    elif img_align_y == "bottom":
        by = free_h
    else:
        by = free_h // 2

    block_x = cell_x + bx
    block_y = cell_y + by

    if not show_labels:
        off_x = cell_w - li.iw
        off_y = cell_h - li.ih
        if img_align_x == "left":
            img_x = cell_x
        elif img_align_x == "right":
            img_x = cell_x + off_x
        else:
            img_x = cell_x + off_x // 2
        if img_align_y == "top":
            img_y = cell_y
        elif img_align_y == "bottom":
            img_y = cell_y + off_y
        else:
            img_y = cell_y + off_y // 2
        return img_x, img_y, 0, 0, 0

    if label_pos == "bottom":
        text_box_x = block_x
        text_box_y = block_y + li.ih + li.padding
        text_box_w = li.block_w
    elif label_pos == "top":
        text_box_x = block_x
        text_box_y = block_y
        text_box_w = li.block_w
    elif label_pos == "left":
        text_box_x = block_x
        text_box_y = block_y
        text_box_w = li.text_w
    else:  # right
        text_box_x = block_x + li.iw + li.padding
        text_box_y = block_y
        text_box_w = li.text_w

    if label_pos in ("bottom", "top"):
        off = li.block_w - li.iw
        if img_align_x == "left":
            img_x = block_x
        elif img_align_x == "right":
            img_x = block_x + off
        else:
            img_x = block_x + off // 2
        img_y = block_y if label_pos == "bottom" else block_y + li.text_h + li.padding
    else:  # left / right
        off = li.block_h - li.ih
        if img_align_y == "top":
            img_y = block_y
        elif img_align_y == "bottom":
            img_y = block_y + off
        else:
            img_y = block_y + off // 2
        img_x = block_x if label_pos == "left" else block_x + li.text_w + li.padding

    return img_x, img_y, text_box_x, text_box_y, text_box_w


def _render_grid(layout: GridLayout, settings, renderer, preview,
                 preview_thumbs, bg_color, text_color, line_spacing, log):
    canvas = Image.new("RGBA", (layout.canvas_w, layout.canvas_h),
                       (bg_color[0], bg_color[1], bg_color[2], 255))
    draw = ImageDraw.Draw(canvas)

    img_align_x = settings.get("img_align_x", "center")
    img_align_y = settings.get("img_align_y", "top")
    label_pos = settings.get("label_position", "bottom")
    label_align = settings.get("label_align", "center")
    show_labels = bool(settings.get("show_labels", True))

    for idx, li in enumerate(layout.items):
        r = idx // layout.cols
        c = idx % layout.cols
        cell_x = layout.gap + c * (layout.cell_w + layout.gap)
        cell_y = layout.gap + r * (layout.cell_h + layout.gap)

        img_x, img_y, tbx, tby, tbw = _compute_positions(
            li, cell_x, cell_y, layout.cell_w, layout.cell_h,
            img_align_x, img_align_y, label_pos, show_labels)

        _paste_image(canvas, li, img_x, img_y, preview, preview_thumbs,
                     layout.scale_factor, log)

        if not show_labels or not li.lines:
            continue

        if label_pos in ("bottom", "top"):
            text_y = tby
        else:
            if label_align == "left":
                text_y = tby
            elif label_align == "right":
                text_y = tby + (li.ih - li.text_h)
            else:
                text_y = tby + (li.ih - li.text_h) // 2

        for line in li.lines:
            lw, _ = renderer.measure(line)
            if label_pos in ("bottom", "top"):
                if label_align == "left":
                    line_x = tbx
                elif label_align == "right":
                    line_x = tbx + (tbw - lw)
                else:
                    line_x = tbx + (tbw - lw) // 2
            else:
                line_x = tbx + (tbw - lw) // 2
            renderer.draw(draw, line_x, text_y, line, text_color)
            text_y += li.line_h + line_spacing

    used_rows = math.ceil(len(layout.items) / layout.cols)
    final_h = layout.gap + used_rows * (layout.cell_h + layout.gap)
    if final_h < layout.canvas_h:
        canvas = canvas.crop((0, 0, layout.canvas_w, final_h))
    return canvas


# ---------------------------------------------------------------------------
# Публичные функции сборки
# ---------------------------------------------------------------------------

def preview_grid(items, settings, renderer, preview_max_size=1000,
                 bg_override=None, log=lambda m: None) -> BuildResult:
    """Собирает уменьшенный предпросмотр на основе готовых миниатюр."""
    if not HAS_PIL:
        return BuildResult(False, "Pillow не установлен")

    enabled = [it for it in items if it.enabled and it.width > 0 and it.thumb is not None]
    if not enabled:
        return BuildResult(False, "Нет изображений с готовыми миниатюрами")

    show_labels = bool(settings.get("show_labels", True))
    if show_labels and not renderer.has_font():
        return BuildResult(False, "Шрифт недоступен")

    bg = tuple(bg_override) if bg_override is not None else tuple(settings["bg_color"])
    text_color = tuple(settings["text_color"])
    line_spacing = int(settings["line_spacing"])

    layout, renderer, _limit = _prepare_layout(
        enabled, settings, renderer, preview=True,
        preview_max_size=preview_max_size, log=log)

    line_spacing_eff = max(0, int(round(line_spacing * layout.scale_factor)))
    thumbs = {it.path: it.thumb for it in enabled}

    try:
        canvas = _render_grid(layout, settings, renderer, True, thumbs,
                              bg, text_color, line_spacing_eff, log)
    except MemoryError:
        return BuildResult(False, "Не хватает памяти для предпросмотра")

    return BuildResult(True, "", canvas)


def build_grid(items, out_path, settings, renderer, log=print,
               bg_override=None) -> BuildResult:
    """Собирает финальное изображение и сохраняет в out_path."""
    if not HAS_PIL:
        return BuildResult(False, "Pillow не установлен")

    enabled = [it for it in items if it.enabled and it.width > 0]
    if not enabled:
        return BuildResult(False, "Нет включённых изображений.")

    show_labels = bool(settings.get("show_labels", True))
    if show_labels and not renderer.has_font():
        log("Шрифт недоступен (ни файл, ни встроенный).")
        return BuildResult(False, "Шрифт недоступен (ни файл, ни встроенный).")

    bg = tuple(bg_override) if bg_override is not None else tuple(settings["bg_color"])
    text_color = tuple(settings["text_color"])
    line_spacing = int(settings["line_spacing"])

    layout, renderer, limit = _prepare_layout(
        enabled, settings, renderer, preview=False,
        preview_max_size=0, log=log)

    log("Сетка: {} x {}".format(layout.cols, layout.rows))

    line_spacing_eff = max(0, int(round(line_spacing * layout.scale_factor)))

    try:
        canvas = _render_grid(layout, settings, renderer, False, {},
                              bg, text_color, line_spacing_eff, log)
    except MemoryError:
        return BuildResult(False,
                           "Не хватает памяти для холста {}x{} ({:.1f} Мп)."
                           .format(layout.canvas_w, layout.canvas_h,
                                   layout.canvas_w * layout.canvas_h / 1e6))
    except Exception as e:
        return BuildResult(False, "Ошибка рендера: {}: {}".format(type(e).__name__, e))

    # Финальная проверка размера на всякий случай
    w, h = canvas.size
    if w * h > limit:
        k = math.sqrt(limit / (w * h))
        new_size = (max(1, int(w * k)), max(1, int(h * k)))
        resized = canvas.resize(new_size, Image.LANCZOS)
        canvas.close()
        canvas = resized
        log("Финальное уменьшение до {}x{} ({:.1f} Мп)".format(
            new_size[0], new_size[1], new_size[0] * new_size[1] / 1e6))

    try:
        canvas.convert("RGB").save(out_path, "PNG")
    except MemoryError:
        return BuildResult(False, "Не хватает памяти при сохранении PNG.")
    except Exception as e:
        return BuildResult(False, "Ошибка сохранения: {}: {}".format(type(e).__name__, e))

    log("Результат: {} ({}x{})".format(out_path, canvas.size[0], canvas.size[1]))
    return BuildResult(True, "")


