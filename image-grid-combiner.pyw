                self.font_hint_var.set(
                    "Встроенный шрифт: {} ({:.0f} КБ).".format(EMBEDDED_FONT_NAME, kb))
        elif os.path.isfile(p):
            self.font_hint_var.set("Внешний шрифт: {}".format(os.path.basename(p)))
        else:
            self.font_hint_var.set("Шрифт не найден — используется встроенный.")

