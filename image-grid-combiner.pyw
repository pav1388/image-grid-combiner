EMBEDDED_FONT_BYTES_CACHE = None
EMBEDDED_FONT_BASE64 = (
    ""
)

def embedded_font_bytes() -> bytes:
    global EMBEDDED_FONT_BYTES_CACHE
    if EMBEDDED_FONT_BYTES_CACHE is not None:
        return EMBEDDED_FONT_BYTES_CACHE
    if not EMBEDDED_FONT_BASE64:
        EMBEDDED_FONT_BYTES_CACHE = b""
        return b""
    try:
        EMBEDDED_FONT_BYTES_CACHE = base64.b64decode(EMBEDDED_FONT_BASE64)
    except Exception:
        EMBEDDED_FONT_BYTES_CACHE = b""
    return EMBEDDED_FONT_BYTES_CACHE


def random_pastel_color() -> Tuple[int, int, int]:
    h = random.random()
    s = random.uniform(0.15, 0.35)
    v = random.uniform(0.88, 1.0)
    r, g, b = colorsys.hsv_to_rgb(h, s, v)
    return (int(r * 255), int(g * 255), int(b * 255))


def hex_to_rgb(s: str) -> Tuple[int, int, int]:
    s = s.lstrip("#")
    if len(s) == 3:
        s = "".join(c * 2 for c in s)
    return (int(s[0:2], 16), int(s[2:4], 16), int(s[4:6], 16))


