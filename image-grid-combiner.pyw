def apply_tk_theme_recursive(widget, palette: dict, skip=()):
    """Рекурсивно применяет цвета к 'классическим' tk-виджетам."""
    for w in widget.winfo_children():
        if w in skip:
            continue
        try:
            cls = w.winfo_class()
            if cls in ("Frame", "Toplevel"):
                w.configure(bg=palette["bg"])
            elif cls == "Label":
                # свеотчи и тултипы красим тоже
                w.configure(bg=palette["bg"], fg=palette["fg"])
            elif cls == "Canvas":
                w.configure(bg=palette["canvas_bg"], highlightthickness=0)
            elif cls == "Text":
                w.configure(bg=palette["log_bg"], fg=palette["log_fg"],
                            insertbackground=palette["log_fg"],
                            selectbackground=palette["select_bg"],
                            selectforeground=palette["select_fg"])
            elif cls == "Entry":
                w.configure(bg=palette["field_bg"], fg=palette["field_fg"],
                            insertbackground=palette["field_fg"],
                            selectbackground=palette["select_bg"],
                            selectforeground=palette["select_fg"])
        except tk.TclError:
            pass
        apply_tk_theme_recursive(w, palette, skip=skip)


