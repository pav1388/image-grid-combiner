    # --- Файлы ---

    def pick_folder(self):
        d = filedialog.askdirectory(initialdir=self.input_folder_var.get())
        if d:
            self.input_folder_var.set(d)
            self.refresh_files()

    def pick_output_dir(self):
        d = filedialog.askdirectory(
            initialdir=self.output_dir_var.get() or self.input_folder_var.get())
        if d:
            self.output_dir_var.set(d)

    def clear_output_dir(self):
        self.output_dir_var.set("")

    def refresh_files(self):
        folder = self.input_folder_var.get()
        if not os.path.isdir(folder):
            self.log("Папка не найдена: {}".format(folder))
            return

        self._files_ready = False
        if self._preview_job is not None:
            try:
                self.after_cancel(self._preview_job)
            except Exception:
                pass
            self._preview_job = None

        old_state = {p: it.enabled for p, it in self.item_by_path.items()}
        self.tree.delete(*self.tree.get_children())
        self.items = []
        self.item_by_path = {}

        try:
            names = [f for f in os.listdir(folder) if f.lower().endswith(IMAGE_EXTS)]
        except Exception as e:
            self.log("Ошибка чтения папки: {}".format(e))
            return

        out_name = self.output_file_var.get()
        out_dir = self.output_dir_var.get()
        if out_name and (not out_dir or os.path.abspath(out_dir) == os.path.abspath(folder)):
            names = [f for f in names if f != out_name]

        names.sort(reverse=(self.sort_var.get() == "name_rev"))

        for name in names:
            path = os.path.join(folder, name)
            item = ImageItem(path=path, name=name, label=os.path.splitext(name)[0])
            item.enabled = old_state.get(path, True)
            self.items.append(item)
            self.item_by_path[path] = item
            self.tree.insert("", "end", iid=path, values=(" ", name, "", "", "🔍"))
            self._update_tree_row(item)

        self.log("Найдено изображений: {}.".format(len(self.items)))
        self._update_files_count()
        threading.Thread(target=self._load_thumbnails, daemon=True).start()

    def _load_thumbnails(self):
        try:
            size = int(self.thumbnail_max_size_var.get())
        except Exception:
            size = 48
        snapshot = list(self.items)
        if not snapshot:
            self._files_ready = True
            return
        self._thumbs_active = True
        self.after(0, self._update_thumb_status)
        for it in snapshot:
            try:
                it.load_thumb(thumb_size=(size, size))
            except Exception as e:
                it.error = str(e)
            try:
                self.after(0, self._update_tree_row, it)
            except Exception:
                pass
        self._files_ready = True
        self._thumbs_active = False
        self.after(0, self._update_thumb_status)

    def _update_thumb_status(self):
        if self._building or self._preview_busy:
            return
        self.preview_busy_var.set("МИНИАТЮРЫ..." if self._thumbs_active else "")

    # --- Рендерер ---

    def _configure_renderer(self):
        if not self.show_labels_var.get():
            return  
        scale = max(1, int(self.font_size_scale_var.get()))
        size = int(self.font_size_var.get()) * scale
        path = self.font_path_var.get()
        if path and os.path.isfile(path):
            self.renderer.use_font(path, size)
        else:
            self.renderer.use_font_bytes(self._embedded_font_bytes, size,
                                         name=EMBEDDED_FONT_NAME)
        self.renderer.set_styles(
            bold=self.font_bold_var.get(),
            italic=self.font_italic_var.get(),
            underline=self.font_underline_var.get(),
        )

    # --- Превью ---

    def schedule_preview(self, delay=PREVIEW_DELAY, force=False):
        if not self._files_ready:
            return
        if not bool(self.auto_preview_var.get()) and not force:
            return
        if self._preview_job is not None:
            try:
                self.after_cancel(self._preview_job)
            except Exception:
                pass
        self._preview_job = self.after(delay, self._run_preview)

    def _run_preview(self):
        self._preview_job = None
        if not self._files_ready:
            return
        if self._thumbs_active:
            self.schedule_preview(PREVIEW_DELAY, force=True)
            return
        if self._preview_busy:
            self.schedule_preview(PREVIEW_DELAY)
            return
        if not self.items:
            return

        settings = self._collect_build_settings()
        items = list(self.items)
        self._configure_renderer()
        renderer = self.renderer
        bg = self._current_bg_color()
        preview_max_size = int(self.preview_max_size_var.get() or 500)

        self._preview_busy = True
        self.preview_busy_var.set("РЕНДЕР...")

        def worker():
            try:
                res = preview_grid(items, settings, renderer,
                                   preview_max_size=preview_max_size,
                                   bg_override=bg)
                self.after(0, self._apply_preview, res)
            except Exception as e:
                self.after(0, lambda: self.preview_busy_var.set("ошибка: {}".format(e)))
            finally:
                self.after(0, self._preview_done)

        threading.Thread(target=worker, daemon=True).start()

    def _preview_done(self):
        self._preview_busy = False
        if not self._building:
            self._update_thumb_status()

    def _apply_preview(self, res: BuildResult):
        if not res.ok or res.image is None:
            return
        self._preview_pil = res.image
        self._render_preview_image()

    def _render_preview_image(self):
        if not self._preview_pil:
            return
        img = self._preview_pil
        cw = max(1, self.preview_canvas.winfo_width())
        ch = max(1, self.preview_canvas.winfo_height())
        iw, ih = img.size
        k = min(1.0, cw / iw, ch / ih)
        disp = img.resize((max(1, int(iw * k)), max(1, int(ih * k))), Image.BILINEAR) if k < 1.0 else img
        self.preview_image = ImageTk.PhotoImage(disp)
        self.preview_canvas.delete("all")
        self.preview_canvas.create_image(0, 0, anchor="nw", image=self.preview_image)
        self.preview_canvas.configure(scrollregion=(0, 0, disp.size[0], disp.size[1]))

    # --- Сборка ---

    def _current_bg_color(self) -> Tuple[int, int, int]:
        if self.random_bg_color_var.get():
            return self._random_bg_color
        return hex_to_rgb(self.bg_var.get())

    def _collect_build_settings(self) -> dict:
        return {
            "gap": int(self.gap_var.get()),
            "padding": int(self.padding_var.get()),
            "line_spacing": int(self.line_space_var.get()),
            "show_labels": bool(self.show_labels_var.get()),
            "size_mode": self.size_mode_var.get(),
            "bg_color": self._current_bg_color(),
            "text_color": hex_to_rgb(self.text_var.get()),
            "target_ratio": float(self.ratio_var.get()),
            "force_cols": int(self.cols_var.get()),
            "sort_key": self.sort_var.get(),
            "random_bg_color": bool(self.random_bg_color_var.get()),
            "img_align_x": self.img_align_x_var.get(),
            "img_align_y": self.img_align_y_var.get(),
            "label_position": self.label_pos_var.get(),
            "label_align": self.label_align_var.get(),
            "output_max_megapixels": int(self.output_max_megapixels_var.get() or 0),
        }

    def _resolve_output_path(self) -> str:
        name = self.output_file_var.get().strip() or "combined_grid.png"
        if not name.lower().endswith(".png"):
            name += ".png"
        out_dir = self.output_dir_var.get().strip() or self.input_folder_var.get()
        return os.path.join(out_dir, name)

    def open_folder(self):
        path = self.output_dir_var.get() or self.input_folder_var.get()
        if not os.path.isdir(path):
            path = self.input_folder_var.get()
        self._open_path(path)

    def open_output_file(self):
        path = self._resolve_output_path()
        if not os.path.isfile(path):
            messagebox.showinfo("Файл не найден",
                                "Выходной файл ещё не создан:\n{}".format(path))
            return
        self._open_path(path)

    def run_build(self):
        if not self.items:
            messagebox.showerror("Ошибка", "Список файлов пуст.")
            return
        folder = self.input_folder_var.get()
        if not os.path.isdir(folder):
            messagebox.showerror("Ошибка", "Папка не найдена.")
            return

        out_path = self._resolve_output_path()
        try:
            os.makedirs(os.path.dirname(out_path), exist_ok=True)
        except Exception as e:
            messagebox.showerror("Ошибка", "Не удалось создать папку:\n{}".format(e))
            return

        settings = self._collect_build_settings()
        enabled = [it for it in self.items if it.enabled and it.width > 0]
        if not enabled:
            messagebox.showerror("Ошибка", "Нет включённых файлов для сборки.")
            return

        self._configure_renderer()
        renderer = self.renderer
        bg = self._current_bg_color()
        use_random_bg = bool(self.random_bg_color_var.get())

        self.log("Сборка: {} файлов".format(len(enabled)))
        self._building = True
        self.preview_busy_var.set("СБОРКА...")

        def worker():
            ok = False
            try:
                res = build_grid(enabled, out_path, settings, renderer,
                                 log=self._log_threadsafe, bg_override=bg)
                ok = res.ok
                if res.ok:
                    self.after(0, lambda: self.log("Готово.\n"))
                else:
                    self.after(0, lambda m=res.message: self.log("Ошибка: {}".format(m)))
            except Exception as e:
                tb = traceback.format_exc()
                err_msg = "{}: {}".format(type(e).__name__, e) if str(e) else type(e).__name__
                self.after(0, lambda m=err_msg, t=tb: self.log("ОШИБКА: {}\n{}".format(m, t)))
                self.after(0, lambda m=err_msg: messagebox.showerror("Ошибка", m))
            finally:
                if use_random_bg:
                    self.after(0, lambda: self._regen_random_bg(refresh_preview=False))
                self.after(0, lambda: self._build_finished(ok))

        threading.Thread(target=worker, daemon=True).start()

    def _build_finished(self, ok: bool):
        self._building = False
        self.preview_busy_var.set("СБОРКА ЗАВЕРШЕНА" if ok else "СБОРКА: ОШИБКА")


if __name__ == "__main__":
    App().mainloop()