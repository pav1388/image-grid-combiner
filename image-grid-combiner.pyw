class TextRenderer:
    def __init__(self):
        self.font_path = ""
        self.font_bytes = b""
        self.font_size = 0
        self.bold = False
        self.italic = False
        self.underline = False
        self._pil_font = None
        self._pil_cache_key = None
        self._font_buf = None
        self._ascent = 0
        self._descent = 0

    def use_font(self, path, size):
        self.font_path = path or ""
        self.font_bytes = b""
        self._font_buf = None
        self.font_size = max(1, int(size))
        self._pil_font = None
        self._pil_cache_key = None

    def use_font_bytes(self, data, size, name=EMBEDDED_FONT_NAME):
        self.font_path = name
        self.font_bytes = data or b""
        self._font_buf = None
        self.font_size = max(1, int(size))
        self._pil_font = None
        self._pil_cache_key = None

    def set_styles(self, bold=False, italic=False, underline=False):
        self.bold = bool(bold)
        self.italic = bool(italic)
        self.underline = bool(underline)

    def scaled_copy(self, factor: float) -> "TextRenderer":
        """Возвращает копию с масштабированным размером шрифта."""
        size = max(1, int(round(self.font_size * factor)))
        r = TextRenderer()
        if self.font_bytes:
            r.use_font_bytes(self.font_bytes, size, name=self.font_path)
        elif self.font_path and os.path.isfile(self.font_path):
            r.use_font(self.font_path, size)
        r.set_styles(self.bold, self.italic, self.underline)
        return r

    def _get_pil_font(self):
        if not HAS_PIL:
            return None
        if self.font_bytes:
            key = ("bytes", hash(self.font_bytes), self.font_size)
        elif self.font_path and os.path.isfile(self.font_path):
            key = ("path", self.font_path, self.font_size)
        else:
            return None
        if self._pil_cache_key == key and self._pil_font is not None:
            return self._pil_font
        self._pil_font = None
        self._font_buf = None
        self._ascent = 0
        self._descent = 0
        try:
            if self.font_bytes:
                self._font_buf = io.BytesIO(self.font_bytes)
                self._pil_font = ImageFont.truetype(self._font_buf, self.font_size)
            else:
                self._pil_font = ImageFont.truetype(self.font_path, self.font_size)
            asc, desc = self._pil_font.getmetrics()
            self._ascent = asc
            self._descent = desc
        except Exception:
            self._pil_font = None
            self._font_buf = None
            self._ascent = 0
            self._descent = 0
            self.font_path = ""
            self.font_bytes = b""
        self._pil_cache_key = key
        return self._pil_font

    def has_font(self) -> bool:
        return self._get_pil_font() is not None

    def _metrics(self) -> Tuple[int, int]:
        f = self._get_pil_font()
        if f is None:
            size = self.font_size or 8
            return size, max(1, size // 4)
        return self._ascent, self._descent

    def line_height(self) -> int:
        asc, desc = self._metrics()
        return max(1, asc + desc)

    def measure(self, text: str) -> Tuple[int, int]:
        f = self._get_pil_font()
        if f is None:
            w = max(1, len(text) * max(1, (self.font_size or 8) // 2))
            return w, self.line_height()
        try:
            w = f.getlength(text) if hasattr(f, "getlength") else f.getbbox(text)[2]
            w = max(1, int(round(w)))
            if self.bold:
                w += 2
            return w, self.line_height()
        except Exception:
            return max(1, len(text) * 8), self.line_height()

    def draw(self, draw, x, y, text, color):
        if not text:
            return
        f = self._get_pil_font()
        if f is None:
            return
        stroke = 1 if self.bold else 0
        if self.italic:
            self._draw_italic(draw, x, y, text, f, color, stroke)
        else:
            draw.text(
                (x, y), text, font=f, fill=color,
                stroke_width=stroke, stroke_fill=color,
                anchor="la",
            )
        if self.underline:
            w = self._text_width(f, text)
            asc, _desc = self._metrics()
            uy = y + asc + max(1, self.font_size // 14)
            draw.line([(x, uy), (x + w, uy)], fill=color,
                      width=max(1, self.font_size // 14))

    def _text_width(self, f, text: str) -> int:
        try:
            w = f.getlength(text) if hasattr(f, "getlength") else f.getbbox(text)[2]
        except Exception:
            w, _ = self.measure(text)
        w = max(1, int(round(w)))
        if self.bold:
            w += 2
        return w

    def _draw_italic(self, draw, x, y, text, font, color, stroke):
        asc, desc = self._metrics()
        w = self._text_width(font, text)
        pad = 4
        tmp_w = max(1, w + pad * 2)
        tmp_h = max(1, asc + desc + pad * 2)
        layer = Image.new("RGBA", (tmp_w, tmp_h), (0, 0, 0, 0))
        ld = ImageDraw.Draw(layer)
        ld.text(
            (pad, pad), text, font=font, fill=color,
            stroke_width=stroke, stroke_fill=color,
            anchor="la",
        )
        shear = 0.2
        layer = layer.transform(
            layer.size, Image.AFFINE,
            (1, shear, -shear * tmp_h, 0, 1, 0),
            resample=Image.BICUBIC,
        )
        base_image = getattr(draw, "_image", None)
        if base_image is None:
            return
        if base_image.mode != "RGBA":
            base_image = base_image.convert("RGBA")
        base_image.alpha_composite(layer, (x - pad, y - pad))


def wrap_text(text: str, max_width: int, renderer: TextRenderer) -> List[str]:
    if not text:
        return [""]
    words = text.split()
    if not words:
        return [""]
    lines: List[str] = []
    current = ""
    for word in words:
        candidate = (current + " " + word) if current else word
        w, _ = renderer.measure(candidate)
        if w <= max_width:
            current = candidate
            continue
        if current:
            lines.append(current)
            current = ""
        w_word, _ = renderer.measure(word)
        if w_word > max_width:
            buf = ""
            for ch in word:
                w_buf, _ = renderer.measure(buf + ch)
                if w_buf > max_width and buf:
                    lines.append(buf)
                    buf = ch
                else:
                    buf += ch
            current = buf
        else:
            current = word
    if current:
        lines.append(current)
    return lines or [""]


# ---------------------------------------------------------------------------
# Планирование сетки и оценка масштаба
# ---------------------------------------------------------------------------

def calculate_grid(n: int, target_ratio: float = 1.0) -> Tuple[int, int]:
    if n <= 1:
        return (1, max(n, 1))
    best = (n, 1)
    best_score = float("inf")
    for cols in range(1, n + 1):
        rows = math.ceil(n / cols)
        ratio = cols / rows
        score = abs(ratio - target_ratio) + (cols * rows - n) * 0.01
        if score < best_score:
            best_score = score
            best = (cols, rows)
    return best


def _estimate_scale(items, settings, renderer, preview, preview_max_size):
    """Возвращает (scale_factor, user_pixel_limit, cols, rows)."""
    n = len(items)
    target_ratio = float(settings["target_ratio"])
    force_cols = int(settings["force_cols"])
    gap = int(settings["gap"])
    padding = int(settings["padding"])
    line_spacing = int(settings["line_spacing"])
    label_pos = settings.get("label_position", "bottom")

    if force_cols > 0:
        est_cols = force_cols
    else:
        est_cols, _ = calculate_grid(n, target_ratio)
    est_rows = math.ceil(n / est_cols)

    max_w = max(it.width for it in items)
    max_h = max(it.height for it in items)

    lh = renderer.line_height()
    worst_text_h = 0
    for it in items:
        approx_lines = max(1, len(it.label) * lh // max(1, max_w))
        approx_lines = min(approx_lines, 20)
        worst_text_h = max(worst_text_h, approx_lines * (lh + line_spacing))

    if label_pos in ("bottom", "top"):
        cell_w = max_w
        cell_h = max_h + padding + worst_text_h + padding
    else:
        cell_w = max_w + padding + max_w // 2 + padding
        cell_h = max_h

    canvas_w = est_cols * cell_w + (est_cols + 1) * gap
    canvas_h = est_rows * cell_h + (est_rows + 1) * gap
    est_pixels = canvas_w * canvas_h

    if preview:
        typical = max(1, max(max_w, max_h))
        target_cell = max(32, int(preview_max_size) // 4) if preview_max_size > 0 else typical
        scale = target_cell / typical if typical > target_cell else 1.0
        return scale, HARD_PIXEL_LIMIT, est_cols, est_rows

    output_max_mp = float(settings.get("output_max_megapixels", 0) or 0)
    if output_max_mp > 0:
        user_pixel_limit = min(int(output_max_mp * 1_000_000), HARD_PIXEL_LIMIT)
    else:
        user_pixel_limit = AUTO_PIXEL_LIMIT

    scale = 1.0
    if est_pixels > user_pixel_limit:
        scale = math.sqrt(user_pixel_limit / est_pixels)
    return scale, user_pixel_limit, est_cols, est_rows


def _build_layout(items, renderer, settings, scale_factor, log):
    """Строит LayoutItem для каждого изображения."""
    gap = max(1, int(round(int(settings["gap"]) * scale_factor)))
    padding = max(1, int(round(int(settings["padding"]) * scale_factor)))
    line_spacing = max(0, int(round(int(settings["line_spacing"]) * scale_factor)))
    label_pos = settings.get("label_position", "bottom")
    show_labels = bool(settings.get("show_labels", True))
    size_mode = settings.get("size_mode", "orig")

    if size_mode == "max":
        target_w = max(it.width for it in items)
        target_h = max(it.height for it in items)
    elif size_mode == "min":
        target_w = min(it.width for it in items)
        target_h = min(it.height for it in items)
    else:
        target_w = target_h = None

    if target_w is not None and scale_factor < 1.0:
        target_w = max(1, int(round(target_w * scale_factor)))
        target_h = max(1, int(round(target_h * scale_factor)))

    layout_items: List[LayoutItem] = []
    for it in items:
        if target_w is not None:
            sw, sh = it.width, it.height
            k = min(target_w / sw, target_h / sh)
            iw = max(1, int(round(sw * k)))
            ih = max(1, int(round(sh * k)))
        elif scale_factor < 1.0:
            iw = max(1, int(round(it.width * scale_factor)))
            ih = max(1, int(round(it.height * scale_factor)))
        else:
            iw, ih = it.width, it.height

        if show_labels:
            lines = wrap_text(it.label, iw, renderer)
            lh_i = renderer.line_height()
            text_h = len(lines) * lh_i + max(0, len(lines) - 1) * line_spacing
            text_w = max((renderer.measure(l)[0] for l in lines), default=0)
        else:
            lines = []
            lh_i = 0
            text_h = 0
            text_w = 0

        if not show_labels:
            block_w = iw
            block_h = ih
        elif label_pos in ("bottom", "top"):
            block_w = iw
            block_h = ih + padding + text_h + padding
        else:
            block_w = iw + padding + text_w + padding
            block_h = ih

        layout_items.append(LayoutItem(
            item=it, lines=lines, line_h=lh_i,
            text_h=text_h, text_w=text_w,
            block_w=block_w, block_h=block_h,
            iw=iw, ih=ih, padding=padding,
        ))
    return layout_items, gap, padding, line_spacing


def _fit_canvas_to_limit(layout_items, cols, rows, cell_w, cell_h, gap,
                         limit, log):
    """Уменьшает layout и геометрию, если холст превышает лимит пикселей."""
    canvas_w = cols * cell_w + (cols + 1) * gap
    canvas_h = rows * cell_h + (rows + 1) * gap
    if canvas_w * canvas_h <= limit:
        return layout_items, cell_w, cell_h, gap, canvas_w, canvas_h

    k = math.sqrt(limit / (canvas_w * canvas_h))
    target_w = max(1, int(canvas_w * k))
    target_h = max(1, int(canvas_h * k))

    sx = target_w / (cols * cell_w + (cols + 1) * gap)
    sy = target_h / (rows * cell_h + (rows + 1) * gap)
    s = min(sx, sy)

    cell_w = max(1, int(cell_w * s))
    cell_h = max(1, int(cell_h * s))
    gap = max(1, int(gap * s))

    new_items = []
    for li in layout_items:
        scale = cell_h / max(1, li.block_h) if li.block_h else 1.0
        if li.block_w:
            scale = min(scale, cell_w / li.block_w)
        scale = min(scale, 1.0)
        new_items.append(LayoutItem(
            item=li.item,
            lines=li.lines,
            line_h=max(1, int(li.line_h * scale)),
            text_h=max(1, int(li.text_h * scale)),
            text_w=max(1, int(li.text_w * scale)),
            block_w=max(1, int(li.block_w * scale)),
            block_h=max(1, int(li.block_h * scale)),
            iw=max(1, int(li.iw * scale)),
            ih=max(1, int(li.ih * scale)),
            padding=max(1, int(li.padding * scale)),
        ))

    canvas_w = cols * cell_w + (cols + 1) * gap
    canvas_h = rows * cell_h + (rows + 1) * gap
    log("Холст уменьшен до {}x{} ({:.1f} Мп)".format(
        canvas_w, canvas_h, canvas_w * canvas_h / 1e6))
    return new_items, cell_w, cell_h, gap, canvas_w, canvas_h


def _prepare_layout(items, settings, renderer, preview, preview_max_size, log):
    """Общий пайплайн: оценка → масштаб → layout → фит по лимиту."""
    scale, limit, _cols, _rows = _estimate_scale(
        items, settings, renderer, preview, preview_max_size)

    if preview:
        log("Превью: scale_factor={:.3f}".format(scale))

    if scale < 1.0:
        renderer = renderer.scaled_copy(scale)

    layout_items, gap, _padding, _line_spacing = _build_layout(
        items, renderer, settings, scale, log)

    cell_w = max(li.block_w for li in layout_items)
    cell_h = max(li.block_h for li in layout_items)

    force_cols = int(settings["force_cols"])
    if force_cols > 0:
        cols = force_cols
        rows = math.ceil(len(items) / cols)
    else:
        cols, rows = calculate_grid(len(items), float(settings["target_ratio"]))

    if not preview:
        layout_items, cell_w, cell_h, gap, canvas_w, canvas_h = _fit_canvas_to_limit(
            layout_items, cols, rows, cell_w, cell_h, gap, limit, log)
    else:
        canvas_w = cols * cell_w + (cols + 1) * gap
        canvas_h = rows * cell_h + (rows + 1) * gap

    return GridLayout(
        items=layout_items, cols=cols, rows=rows,
        cell_w=cell_w, cell_h=cell_h, gap=gap,
        canvas_w=canvas_w, canvas_h=canvas_h, scale_factor=scale,
    ), renderer, limit


