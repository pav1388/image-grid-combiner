class ToolTip:
    """Всплывающая подсказка для кнопок интерфейса."""

    def __init__(self, widget, text, delay=1000, wrap_length=220,
                 bg="#ffffe1", fg="#000000", relief="solid", bd=1):
        self.widget = widget
        self.text = text
        self.delay = delay
        self.wrap_length = wrap_length
        self.bg = bg
        self.fg = fg
        self.relief = relief
        self.bd = bd
        self._tip_win = None
        self._after_id = None
        widget.bind("<Enter>", self._on_enter, add="+")
        widget.bind("<Leave>", self._on_leave, add="+")
        widget.bind("<ButtonPress>", self._on_leave, add="+")

    def _on_enter(self, _event=None):
        self._cancel()
        self._after_id = self.widget.after(self.delay, self._show)

    def _on_leave(self, _event=None):
        self._cancel()
        self._hide()

    def _cancel(self):
        if self._after_id is not None:
            try:
                self.widget.after_cancel(self._after_id)
            except Exception:
                pass
            self._after_id = None

    def _show(self):
        self._after_id = None
        if self._tip_win is not None:
            return
        x = self.widget.winfo_rootx() + self.widget.winfo_width() + 6
        y = self.widget.winfo_rooty() + self.widget.winfo_height() + 6
        win = tk.Toplevel(self.widget)
        win.wm_overrideredirect(True)
        win.attributes("-topmost", True)
        label = tk.Label(
            win, text=self.text, justify="left",
            background=self.bg, foreground=self.fg,
            relief=self.relief, borderwidth=self.bd,
            wraplength=self.wrap_length, padx=6, pady=3,
        )
        label.pack()
        win.update_idletasks()
        w = win.winfo_width()
        sw = self.widget.winfo_screenwidth()
        if x + w > sw:
            x = max(0, self.widget.winfo_rootx() - w - 6)
        win.geometry("+{}+{}".format(x, y))
        self._tip_win = win

    def _hide(self):
        if self._tip_win is not None:
            try:
                self._tip_win.destroy()
            except Exception:
                pass
            self._tip_win = None


def add_tooltip(widget, text, **kwargs):
    return ToolTip(widget, text, **kwargs)


